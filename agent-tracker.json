{
  "tools": [
    {
      "name": "Claude Code",
      "command": "/Users/aashishlal/.local/bin/claude -p '/usage' < /dev/null",
      "metrics": [
        {
          "label": "Weekly Usage",
          "regex": "Current week \\(all models\\): ([^·\\n]+)"
        },
        {
          "label": "Session Usage",
          "regex": "Current session: ([^\\n]+)"
        }
      ]
    },
    {
      "name": "Antigravity",
      "command": "/opt/homebrew/bin/antigravity-usage --json",
      "metrics": [
        {
          "label": "Prompt Credits",
          "regex": "\"remainingPercentage\":\\s*([0-9.]+)"
        }
      ]
    },
    {
      "name": "Command Code",
      "command": "cd \"/Users/aashishlal/Documents/Agent Tracker\" && /opt/homebrew/bin/cmd -p '/usage' < /dev/null",
      "metrics": [
        {
          "label": "Cycle Usage",
          "regex": "([0-9]+%) used"
        },
        {
          "label": "Weekly Limit",
          "regex": "Weekly\\s+[^\\n]*?([0-9]+%)"
        },
        {
          "label": "5-hour Limit",
          "regex": "5-hour\\s+[^\\n]*?([0-9]+%)"
        }
      ]
    }
  ]
}
