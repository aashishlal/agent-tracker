{
  "tools": [
    {
      "name": "Claude Code",
      "command": "/Users/aashishlal/.local/bin/claude -p '/usage' < /dev/null",
      "metrics": [
        {
          "label": "Weekly Usage",
          "regex": "Current week \\(all models\\): ([^·\\n]+)"
        },
        {
          "label": "Session Usage",
          "regex": "Current session: ([^\\n]+)"
        }
      ]
    },
    {
      "name": "Antigravity",
      "command": "cd \"/Users/aashishlal/Documents/Agent Tracker\" && /Users/aashishlal/.local/bin/agy -p '/usage' < /dev/null",
      "metrics": [
        {
          "label": "Gemini Weekly",
          "regex": "GEMINI MODELS(?:(?!CLAUDE)[\\s\\S])*?Weekly Limit[\\s\\S]*?(\\d+%\\s*remaining[^\\n]*|[0-9.]+%|Quota available)"
        },
        {
          "label": "Gemini 5-Hour",
          "regex": "GEMINI MODELS(?:(?!CLAUDE)[\\s\\S])*?Five Hour Limit[\\s\\S]*?(\\d+%\\s*remaining[^\\n]*|[0-9.]+%|Quota available)"
        },
        {
          "label": "Claude Weekly",
          "regex": "CLAUDE AND GPT MODELS[\\s\\S]*?Weekly Limit[\\s\\S]*?(\\d+%\\s*remaining[^\\n]*|[0-9.]+%|Quota available)"
        },
        {
