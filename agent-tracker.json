{
  "tools": [
    {
      "name": "Claude Code",
      "command": "/Users/aashishlal/.local/bin/claude -p '/usage' < /dev/null",
      "metrics": [
        {
          "label": "Weekly Usage",
          "regex": "Current week \\(all models\\): ([^·\\n]+)"
        },
        {
          "label": "Session Usage",
          "regex": "Current session: ([^\\n]+)"
        }
      ]
    },
    {
      "name": "Antigravity",
      "command": "/Users/aashishlal/.local/bin/agy -p '/usage'",
      "metrics": [
        {
          "label": "Gemini Weekly",
          "regex": "GEMINI MODELS(?:(?!CLAUDE)[\\s\\S])*?Weekly Limit\\s*\\n\\s*([^\\n]+)"
        },
        {
          "label": "Gemini 5-Hour",
          "regex": "GEMINI MODELS(?:(?!CLAUDE)[\\s\\S])*?Five Hour Limit\\s*\\n\\s*([^\\n]+)"
        },
        {
          "label": "Claude Weekly",
          "regex": "CLAUDE AND GPT MODELS[\\s\\S]*?Weekly Limit\\s*\\n\\s*([^\\n]+)"
        },
        {
          "label": "Claude 5-Hour",
          "regex": "CLAUDE AND GPT MODELS[\\s\\S]*?Five Hour Limit\\s*\\n\\s*([^\\n]+)"
        }
      ]
    },
    {
      "name": "Command Code",
      "command": "/opt/homebrew/bin/cmd -p '/usage' < /dev/null",
      "metrics": [
        {
          "label": "Cycle Usage",
          "regex": "([█░]+\\s*[0-9]+%\\s*used)"
        },
        {
          "label": "Weekly Limit",
          "regex": "Weekly\\s+([^\\n]+)"
        },
        {
          "label": "5-hour Limit",
          "regex": "5-hour\\s+([^\\n]+)"
        }
      ]
    }
  ]
}
